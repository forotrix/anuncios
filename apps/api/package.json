{
  "name": "@anuncios/api",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm -C ../../packages/shared build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "new_seed": "tsx scripts/new_seed.ts"
  },
  "dependencies": {
    "@anuncios/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
